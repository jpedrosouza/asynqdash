# Keep UI sources with LF line endings on every platform so that builds are
# reproducible (CI checks that the committed ui/build matches the sources).
ui/src/** text eol=lf
ui/index.html text eol=lf
ui/*.json text eol=lf
ui/*.ts text eol=lf
ui/public/*.md text eol=lf
ui/public/*.json text eol=lf
ui/public/*.txt text eol=lf
ui/public/*.svg text eol=lf

# Generated assets are committed as produced by the build.
ui/build/** -text
